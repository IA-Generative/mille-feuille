# Exemple de configuration globale - copier en `.env` (non versionné, voir
# .gitignore) et remplacer les valeurs par les vraies. `docker compose`
# charge automatiquement ce fichier `.env` à la racine du repo pour
# substituer les ${VARIABLE} référencées dans docker-compose.yaml ; toutes
# ont un défaut de dev intégré, donc `.env` n'est nécessaire que pour
# remplacer une valeur précise (secrets de prod, vrai hub LLM...).

# --- Secrets internes (dev par défaut, à changer en prod) ---
MEILI_MASTER_KEY=
QDRANT_API_KEY=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
SHARE_SECRET_KEY=
INTERNAL_WORKER_TOKEN=
# Clé d'API pour /api/ephemeral/* (16 caractères minimum ; vide = désactivée). Toujours non persistant.
EPHEMERAL_API_KEY=

# --- Modèles LLM (backend/app/config/llm.py, hub compatible API OpenAI) ---
# GET /api/models (et les sélecteurs de modèle conversation/agent) répondent
# 503 tant que ces deux variables sont vides.
OPENAI_API_KEY=
OPENAI_API_BASE_URL=

# --- Hub LLM local avec Ollama (profil `ollama`, voir docs/ollama-local.md) ---
# `docker compose --profile ollama up` démarre Ollama et télécharge OLLAMA_MODELS. Pour s'en servir comme hub,
# décommenter ces lignes (et laisser OPENAI_API_KEY / OPENAI_API_BASE_URL ci-dessus vides). Tous les modèles
# (LLM_MODEL, VLM_MODEL, agents) viennent alors d'Ollama.
# OLLAMA_MODELS=hf.co/ggml-org/SmolVLM-500M-Instruct-GGUF:Q8_0
# OPENAI_API_KEY=ollama
# OPENAI_API_BASE_URL=http://ollama:11434/v1
# VLM_MODEL=hf.co/ggml-org/SmolVLM-500M-Instruct-GGUF:Q8_0
