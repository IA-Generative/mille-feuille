        "additionalProperties": false,
        "description": "Définition complète de l'analyse, créée à la volée pour ce run et supprimée avec lui (exclusif avec analyse_id)",
        "x-titre": "Définition de l'analyse",
        "examples": [
          {
            "name": "Vérification CNI",
            "description": "Classe le document, en extrait le nom et vérifie la cohérence.",
