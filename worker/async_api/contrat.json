{
  "manifeste": 1,
  "nom": "mille-feuille",
  "titre": "Analyser des documents avec mille-feuille",
  "classe": "long",
  "description": "Exécute une analyse mille-feuille (classification, extraction d'entités, agents) sur un ou plusieurs documents déjà déposés dans le stockage, et renvoie le résultat du run. L'analyse est soit définie à la volée dans la requête, soit une analyse mille-feuille existante. Le run n'est jamais conservé côté mille-feuille au-delà de la durée demandée : le résultat est rendu dans la réponse de la tâche.",
  "description_courte": "Pour un ensemble de documents : classe chaque page, en extrait des entités et exécute des agents selon la définition d'analyse fournie.",
  "icone": "fr-icon-search-line",
  "moteur": "Pipeline mille-feuille : texte des pages par OCR ou modèle de vision, classification par modèle de langage et CLIP, extraction d'entités par modèle de langage et GLiNER2.5, agents LangGraph sur un hub compatible OpenAI",
  "taille_max_fichier_mio": 50,
  "gpu": false,
  "entree": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
      "files"
    ],
    "additionalProperties": false,
    "oneOf": [
      {
        "required": [
          "analysis"
        ],
        "not": {
          "required": [
            "analyse_id"
          ]
        }
      },
      {
        "required": [
          "analyse_id"
        ],
        "not": {
          "required": [
            "analysis"
          ]
        }
      }
    ],
    "properties": {
      "files": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "description": "Documents à analyser (1 à 20), préalablement déposés dans le stockage ; 50 Mio au plus chacun, 100 Mio au plus en tout",
        "x-titre": "Documents",
        "examples": [
          [
            {
              "file_id": "client1/a1b2c3d4/cni.pdf",
              "name": "cni.pdf"
            }
          ]
        ],
        "items": {
          "type": "object",
          "required": [
            "file_id"
          ],
          "additionalProperties": false,
          "properties": {
            "file_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "description": "Identifiant S3 du fichier préalablement uploadé via POST /v1/storage/upload",
              "examples": [
                "client1/a1b2c3d4/cni.pdf"
              ],
              "x-titre": "Document"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "description": "Nom d'affichage du document (par défaut, le dernier segment de file_id)",
              "examples": [
                "cni.pdf"
              ],
              "x-titre": "Nom"
            }
          },
          "examples": [
            {
              "file_id": "client1/a1b2c3d4/cni.pdf",
              "name": "cni.pdf"
            }
          ]
        }
      },
      "analysis": {
