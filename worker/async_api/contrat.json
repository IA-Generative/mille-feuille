{
  "manifeste": 1,
  "nom": "mille-feuille",
  "titre": "Analyser des documents avec mille-feuille",
  "classe": "long",
  "description": "Exécute une analyse mille-feuille (classification, extraction d'entités, agents) sur un ou plusieurs documents déjà déposés dans le stockage, et renvoie le résultat complet du run. L'analyse est soit définie à la volée dans la requête, soit une analyse mille-feuille existante.",
  "description_courte": "Pour un ensemble de documents : classe chaque document, en extrait des entités et exécute des agents selon la définition d'analyse fournie.",
  "icone": "fr-icon-search-line",
  "entree": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["files"],
    "additionalProperties": false,
    "oneOf": [{ "required": ["analysis"] }, { "required": ["analyse_id"] }],
    "properties": {
      "files": {
        "type": "array",
        "minItems": 1,
        "description": "Documents à analyser, préalablement déposés dans le stockage",
        "x-titre": "Documents",
        "items": {
          "type": "object",
          "required": ["file_id"],
          "additionalProperties": false,
          "properties": {
            "file_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "description": "Identifiant S3 du fichier préalablement uploadé via POST /v1/storage/upload",
              "examples": ["astree/a1b2c3d4/CNI.pdf"],
              "x-titre": "Document"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Nom d'affichage du document (par défaut, le dernier segment de file_id)",
              "x-titre": "Nom"
            }
          }
        }
      },
      "analysis": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "description": "Définition complète de l'analyse, créée à la volée pour ce run (exclusif avec analyse_id)",
        "x-titre": "Définition de l'analyse",
        "properties": {
          "name": { "type": "string", "minLength": 1, "x-titre": "Nom" },
          "description": { "type": "string", "x-titre": "Description" },
          "persist": { "type": "boolean", "default": false, "description": "true : l'analyse est conservée après le run" },
          "classification_prompt": { "type": "string", "x-titre": "Consigne de classification" },
          "multi_label": {
            "type": "boolean",
            "default": false,
            "description": "true : une page peut recevoir plusieurs labels (sinon un seul par page)",
            "x-titre": "Plusieurs catégories par page"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "definition": { "type": "string" }
              }
            }
          },
          "extraction_prompt": { "type": "string", "x-titre": "Consigne d'extraction" },
          "entities": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "definition": { "type": "string" },
                "type": { "enum": ["texte", "date", "nombre", "booléen", "identifiant"] }
              }
            }
          },
          "agents": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "prompt"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "prompt": { "type": "string", "minLength": 1 },
                "tools": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "lecture_document",
                      "recherche_web",
                      "base_connaissances",
                      "appel_agent",
                      "calculatrice",
                      "verification_coherence"
                    ]
                  }
                },
                "output": { "type": "boolean", "default": true },
                "model": { "type": ["string", "null"] }
              }
            }
          }
        }
      },
      "analyse_id": {
        "type": "string",
        "format": "uuid",
        "description": "Identifiant d'une analyse mille-feuille existante (exclusif avec analysis)",
        "x-titre": "Analyse existante"
      },
      "ttl_hours": {
        "type": "integer",
        "minimum": 1,
        "maximum": 17520,
        "default": 24,
        "description": "Durée de conservation du résultat côté mille-feuille, en heures",
        "x-titre": "Durée de conservation (h)"
      },
      "persist": {
        "type": "boolean",
        "default": false,
        "description": "true : le run et ses fichiers sont conservés dans mille-feuille (sans expiration)",
        "x-titre": "Conserver le run"
      }
    }
  }
}
