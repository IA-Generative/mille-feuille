# Dev-only : lance le serveur Vite avec HMR au lieu de builder nginx.
# Utilisé par docker-compose.override.yaml (fusionné automatiquement par
# `docker compose up`). Les sources sont montées en bind mount, donc les
# modifications sont détectées par Vite instantanément.
FROM node:26-alpine
WORKDIR /app
# Cache corepack partagé : sans ça, pnpm est téléchargé dans ~root au build,
# puis re-téléchargé au démarrage par l'utilisateur `node` (cache vide), ce
# qui échoue si le conteneur n'a pas accès au registre npm.
ENV COREPACK_HOME=/usr/local/share/corepack
RUN npm install -g corepack && corepack enable && corepack prepare pnpm@9.15.0 --activate
COPY package.json pnpm-lock.yaml* .dsfr.yml ./
RUN pnpm install --frozen-lockfile
# Sans ça, le process tourne en root : tout ce qu'il écrit dans le bind
# mount (./frontend:/app, voir docker-compose.override.yaml) atterrit
# root-owned côté hôte. L'image node fournit un utilisateur `node` en uid
# 1000, qui correspond à l'utilisateur hôte habituel sur Linux.
RUN chown -R node:node /app "$COREPACK_HOME"
USER node
EXPOSE 5173
# Vite écoute sur 5173 dès qu'il est prêt ; on teste le port plutôt que la page : sans le bind mount des sources
# (image seule), `/` répond 404 alors que le serveur tourne.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD nc -z localhost 5173 || exit 1
CMD ["pnpm", "dev"]
