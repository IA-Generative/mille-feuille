{
  "name": "mille-feuille-frontend",
  "private": true,
  "version": "0.77.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.node.json",
    "screenshot": "node scripts/screenshot.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@gouvfr/dsfr": "^1.15.4",
    "@gouvminint/vue-dsfr": "^8.21.0",
    "@sigma/layer-webgl": "^4.0.0",
    "@sigma/node-border": "^4.0.0",
    "@sigma/node-image": "^4.0.2",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "marked": "^18.2.1",
    "sigma": "^4.0.6",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.6.10",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.2",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^31.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2",
    "vue-tsc": "^3.3.14"
  },
  "pnpm": {
    "overrides": {
      "source-map-js": ">=1.2.2"
    }
  }
}
