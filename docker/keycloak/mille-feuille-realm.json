{
  "realm": "mille-feuille",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "verifyEmail": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "clients": [
    {
      "clientId": "mille-feuille-backend",
      "name": "mille-feuille BFF",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-only-secret-not-for-prod",
      "redirectUris": [
        "http://localhost:8000/api/auth/callback",
        "http://localhost:8081/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:8081",
        "http://localhost:5173"
      ],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "standard.token.exchange.enabled": "true"
      }
    },
    {
      "clientId": "mille-feuille-mcp-demo",
      "name": "Serveur MCP de démonstration (audience d'un échange de jeton)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-only-mcp-demo-secret-not-for-prod",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "roles": {
    "client": {
      "mille-feuille-mcp-demo": [
        { "name": "use", "description": "Peut utiliser ce serveur MCP" }
      ]
    }
  },
  "users": [
    {
      "username": "agent",
      "enabled": true,
      "email": "agent@millefeuille.fr",
      "firstName": "Agent",
      "lastName": "Instructeur",
      "credentials": [
        {
          "type": "password",
          "value": "agent",
          "temporary": false
        }
      ],
      "realmRoles": ["default-roles-mille-feuille"],
      "clientRoles": {
        "mille-feuille-backend": ["agent"],
        "mille-feuille-mcp-demo": ["use"]
      }
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@millefeuille.fr",
      "firstName": "Admin",
      "lastName": "Millefeuille",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": ["default-roles-mille-feuille"],
      "clientRoles": {
        "mille-feuille-backend": ["admin"],
        "mille-feuille-mcp-demo": ["use"]
      }
    }
  ]
}
